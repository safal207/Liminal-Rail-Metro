{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/Liminal-Rail-Metro/protocol/liminal.codex.coding.contract.v0.3.json",
  "title": "Liminal Codex Coding Contract v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "workflow_id",
    "repository",
    "issue_number",
    "issue_url",
    "issue_title",
    "issue_snapshot_hash",
    "base_sha",
    "allowed_path_prefixes",
    "required_checks",
    "packet",
    "decision_request",
    "decision",
    "gate",
    "created_at",
    "issuer_id",
    "issuer_key_id",
    "issuer_public_key_base64",
    "signature_algorithm",
    "contract_hash",
    "signature_base64"
  ],
  "properties": {
    "protocol": {"const": "liminal.codex.coding.contract.v0.3"},
    "workflow_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "issue_number": {"type": "integer", "minimum": 1},
    "issue_url": {"type": "string", "format": "uri"},
    "issue_title": {"type": "string", "minLength": 1},
    "issue_snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "allowed_path_prefixes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
    "required_checks": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
    "packet": {"type": "object"},
    "decision_request": {"type": "object"},
    "decision": {"type": "object"},
    "gate": {"type": "object"},
    "created_at": {"type": "string"},
    "issuer_id": {"type": "string", "minLength": 1},
    "issuer_key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issuer_public_key_base64": {"type": "string", "minLength": 1},
    "signature_algorithm": {"const": "ed25519"},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_base64": {"type": "string", "minLength": 1}
  }
}
