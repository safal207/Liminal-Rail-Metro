{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liminal-rail.local/protocol/policy.authority.manifest.v1.1.json",
  "title": "Liminal Policy Authority Manifest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "authority_id",
    "generation",
    "bindings",
    "manifest_hash"
  ],
  "properties": {
    "protocol": {
      "const": "liminal.policy-authority.manifest.v1.1"
    },
    "authority_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_class",
          "action_kind",
          "target",
          "side_effect",
          "policy"
        ],
        "properties": {
          "operation_class": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "type": "object"
          },
          "action_kind": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "side_effect": {
            "type": "boolean"
          }
        }
      }
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
