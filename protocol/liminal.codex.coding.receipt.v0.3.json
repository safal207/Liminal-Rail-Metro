{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/Liminal-Rail-Metro/protocol/liminal.codex.coding.receipt.v0.3.json",
  "title": "Liminal Codex Coding Receipt v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "workflow_id",
    "contract_hash",
    "repository",
    "issue_number",
    "pull_request_number",
    "pull_request_url",
    "base_sha",
    "head_sha",
    "files_hash",
    "checks_hash",
    "required_checks",
    "status",
    "verified_at",
    "issuer_id",
    "issuer_key_id",
    "issuer_public_key_base64",
    "signature_algorithm",
    "receipt_hash",
    "signature_base64"
  ],
  "properties": {
    "protocol": {"const": "liminal.codex.coding.receipt.v0.3"},
    "workflow_id": {"type": "string", "minLength": 1},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string"},
    "issue_number": {"type": "integer", "minimum": 1},
    "pull_request_number": {"type": "integer", "minimum": 1},
    "pull_request_url": {"type": "string", "format": "uri"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "files_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"const": "VERIFIED"},
    "verified_at": {"type": "string"},
    "issuer_id": {"type": "string", "minLength": 1},
    "issuer_key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issuer_public_key_base64": {"type": "string", "minLength": 1},
    "signature_algorithm": {"const": "ed25519"},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_base64": {"type": "string", "minLength": 1}
  }
}
