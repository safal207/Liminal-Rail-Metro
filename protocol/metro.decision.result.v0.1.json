{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metro.decision.result.v0.1",
  "title": "Metro Fast Decision Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "action_id",
    "provider_id",
    "packet_hash",
    "state_hash",
    "choices_hash",
    "selected_choice_id",
    "probabilities",
    "confidence",
    "decided_at"
  ],
  "properties": {
    "protocol": {
      "const": "metro.decision.result.v0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "choices_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selected_choice_id": {
      "type": "string",
      "minLength": 1
    },
    "probabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["choice_id", "probability"],
        "properties": {
          "choice_id": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
