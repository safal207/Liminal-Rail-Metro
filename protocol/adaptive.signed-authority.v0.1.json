{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liminal-rail:adaptive.signed-authority:v0.1",
  "title": "Liminal Rail Signed Authority v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "grant",
    "issuer_id",
    "issuer_key_id",
    "issuer_public_key_base64",
    "signature_algorithm",
    "issued_at",
    "signature_base64",
    "signed_authority_hash"
  ],
  "properties": {
    "protocol": { "const": "liminal.adaptive.signed-authority.v0.1" },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "authority_id", "epoch", "allowed_actions", "authority_hash"],
      "properties": {
        "protocol": { "const": "liminal.adaptive.authority.v0.1" },
        "authority_id": { "type": "string", "minLength": 1 },
        "epoch": { "type": "string", "minLength": 1 },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "authority_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "issuer_id": { "type": "string", "minLength": 1 },
    "issuer_key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issuer_public_key_base64": { "type": "string", "minLength": 40 },
    "signature_algorithm": { "const": "ed25519" },
    "issued_at": { "type": "string", "format": "date-time" },
    "signature_base64": { "type": "string", "minLength": 80 },
    "signed_authority_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
