{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liminal-rail:metro.packet:v0.1",
  "title": "Liminal Rail Metro Packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "action_id",
    "source_agent",
    "created_at",
    "goal",
    "action",
    "allowed_targets"
  ],
  "properties": {
    "protocol": {
      "const": "metro.packet.v0.1"
    },
    "action_id": {
      "type": "string",
      "minLength": 8,
      "description": "Stable logical identity assigned before dispatch."
    },
    "source_agent": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "inputs"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object"
        }
      }
    },
    "allowed_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context_refs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "References to external context; large histories should not be copied into the packet by default."
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "side_effect": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "previous_receipt_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Optional provenance link to an earlier verified hop."
    }
  }
}
