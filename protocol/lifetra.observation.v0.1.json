{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liminal-rail:lifetra.observation:v0.1",
  "title": "Lifetra Observation Bridge v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "observation_id",
    "action_id",
    "receipt_id",
    "receipt_status",
    "receipt_hash",
    "hash_algorithm",
    "proof_refs",
    "observed_at"
  ],
  "properties": {
    "protocol": { "const": "lifetra.observation.v0.1" },
    "observation_id": { "type": "string", "minLength": 8 },
    "action_id": {
      "type": "string",
      "minLength": 8,
      "description": "The stable Metro action identity whose execution evidence is being observed."
    },
    "receipt_id": { "type": "string", "minLength": 8 },
    "receipt_status": {
      "type": "string",
      "enum": ["SUCCEEDED", "FAILED", "UNKNOWN", "REJECTED"],
      "description": "Copied without reinterpretation from Metro. UNKNOWN must remain UNKNOWN."
    },
    "receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hash_algorithm": { "const": "sha256" },
    "proof_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "previous_bead_ref": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" }
  }
}
