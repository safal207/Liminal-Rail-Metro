{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/Liminal-Rail-Metro/protocol/portable-proof.v0.1.json",
  "title": "Liminal Portable Proof v0.9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "source_protocol",
    "payload_path",
    "payload_sha256",
    "sigstore_bundle_path",
    "sigstore_bundle_sha256",
    "signing_mode",
    "cosign_release",
    "certificate_oidc_issuer",
    "certificate_identity_regexp",
    "keyless_signing_completed",
    "independent_cosign_verify_passed",
    "transparency_log_verified_by_cosign",
    "raw_oidc_token_persisted",
    "source_external_identity_verified",
    "source_hardware_upgrade_selected",
    "hardware_backed",
    "remote_hardware_attestation",
    "verification_command",
    "claim"
  ],
  "properties": {
    "protocol": {"const": "liminal.portable-proof.v0.9"},
    "source_protocol": {"const": "liminal.hardware-adaptive-proof.v0.8"},
    "payload_path": {"type": "string", "minLength": 1},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sigstore_bundle_path": {"type": "string", "minLength": 1},
    "sigstore_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sigstore_bundle_media_type": {"type": "string"},
    "signing_mode": {"const": "sigstore-keyless"},
    "cosign_release": {"type": "string", "minLength": 1},
    "certificate_oidc_issuer": {"const": "https://token.actions.githubusercontent.com"},
    "certificate_identity_regexp": {"type": "string", "minLength": 1},
    "keyless_signing_completed": {"const": true},
    "independent_cosign_verify_passed": {"const": true},
    "transparency_log_verified_by_cosign": {"const": true},
    "raw_oidc_token_persisted": {"const": false},
    "source_external_identity_verified": {"const": true},
    "source_hardware_upgrade_selected": {"const": false},
    "hardware_backed": {"const": false},
    "remote_hardware_attestation": {"const": false},
    "verification_command": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1}
  }
}
