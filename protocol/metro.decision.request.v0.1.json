{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metro.decision.request.v0.1",
  "title": "Metro Fast Decision Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "request_id",
    "action_id",
    "state_hash",
    "choices",
    "choices_hash",
    "requested_at"
  ],
  "properties": {
    "protocol": {
      "const": "metro.decision.request.v0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "object"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "choices_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
