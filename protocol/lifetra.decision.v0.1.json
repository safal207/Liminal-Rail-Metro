{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liminal-rail:lifetra.decision:v0.1",
  "title": "Lifetra Decision Bridge v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "decision_id",
    "source_observation_id",
    "source_receipt_ref",
    "caused_by_action_id",
    "verdict",
    "decided_at"
  ],
  "properties": {
    "protocol": { "const": "lifetra.decision.v0.1" },
    "decision_id": { "type": "string", "minLength": 8 },
    "source_observation_id": { "type": "string", "minLength": 8 },
    "source_receipt_ref": { "type": "string", "minLength": 1 },
    "caused_by_action_id": {
      "type": "string",
      "minLength": 8,
      "description": "Prior action that caused the evidence leading to this decision. It is provenance, not the identity of the new action."
    },
    "source_bead_ref": { "type": "string", "minLength": 1 },
    "verdict": {
      "type": "string",
      "enum": ["ALLOW", "REQUIRE_APPROVAL", "BLOCK"]
    },
    "authority_proof_ref": { "type": "string", "minLength": 1 },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "goal", "kind", "inputs", "allowed_targets"],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 8,
          "description": "Stable identity for the new logical action."
        },
        "goal": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "inputs": { "type": "object" },
        "allowed_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "side_effect": { "type": "boolean", "default": false }
      }
    },
    "decided_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "ALLOW" } } },
      "then": { "required": ["authority_proof_ref", "next_action"] }
    }
  ]
}
