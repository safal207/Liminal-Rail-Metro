{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:liminal-rail:adaptive.authority-rotation:v0.1",
  "title": "Liminal Rail Authority Rotation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "authority_id",
    "from_epoch",
    "to_epoch",
    "from_authority_hash",
    "to_authority_hash",
    "from_signed_authority_hash",
    "to_signed_authority_hash",
    "source_journal_sequence",
    "from_issuer_id",
    "from_issuer_key_id",
    "to_issuer_id",
    "to_issuer_key_id",
    "issued_at",
    "signature_algorithm",
    "signature_base64",
    "rotation_hash"
  ],
  "properties": {
    "protocol": { "const": "liminal.adaptive.authority-rotation.v0.1" },
    "authority_id": { "type": "string", "minLength": 1 },
    "from_epoch": { "type": "string", "minLength": 1 },
    "to_epoch": { "type": "string", "minLength": 1 },
    "from_authority_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "to_authority_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "from_signed_authority_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "to_signed_authority_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_journal_sequence": { "type": "integer", "minimum": 0 },
    "source_journal_head": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "from_issuer_id": { "type": "string", "minLength": 1 },
    "from_issuer_key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "to_issuer_id": { "type": "string", "minLength": 1 },
    "to_issuer_key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "signature_algorithm": { "const": "ed25519" },
    "signature_base64": { "type": "string", "minLength": 80 },
    "rotation_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
